@startuml UC-3_Course_Recommendation
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Student" as Student

rectangle "Course Recommendation (FR-5)" {

  ' --- Generate recommendation ---
  usecase "Request Course Recommendation" as UC_Req
  usecase "Determine Eligible Courses" as UC_Elig
  usecase "Apply Credit Limit" as UC_Limit
  usecase "Generate Study Roadmap" as UC_Gen
  usecase "Notify No Suitable Course" as UC_None

  ' --- View recommendation ---
  usecase "View Recommended Roadmap" as UC_Road
  usecase "View Recommendations by Semester" as UC_Sem
  usecase "View Applied Constraints & Regulations" as UC_Cons
  usecase "Explain Recommendation" as UC_Expl
}

' Actor Interactions
Student --> UC_Req
Student --> UC_Road

' Recommendation flow
UC_Req ..> UC_Elig : <<include>>
UC_Req ..> UC_Limit : <<include>>
UC_Req ..> UC_Gen : <<include>>

' View flow
UC_Road ..> UC_Cons : <<include>>

' Optional/Extended Features
UC_None .up.> UC_Req : <<extend>>
UC_Sem .up.> UC_Road : <<extend>>
UC_Expl .up.> UC_Road : <<extend>>

note right of UC_Elig
  Based on progress, prerequisites and
  curriculum requirements (FR-5.2).
  Reuses Check Course Eligibility (UC-2).
end note

note right of UC_Gen
  Must not conflict with curriculum
  constraints or student data (FR-5.3, 5.4).
end note

note right of UC_None
  No eligible course or no valid roadmap:
  state the reason, never skip rules (FR-5.6).
end note

note right of UC_Sem
  From current semester to the last semester
  of the curriculum (FR-5.7).
end note
@enduml