# =============================================================================
# UniPrep backend — mẫu biến môi trường. Sao chép thành `.env` rồi chỉnh:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (bash)
# Danh sách biến và ý nghĩa: `docs/02-specs/api-specification.md` §14.1–14.2.
# Biến nào chưa dùng ở giai đoạn hiện tại vẫn được khai báo sẵn để máy mới không
# phải đi tìm khi làm tới module tương ứng.
# =============================================================================

# ----- Ứng dụng -----
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ----- PostgreSQL (chạy trực tiếp trên máy, không cần Docker) -----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=uniprep

# ----- Swagger -----
SWAGGER_TITLE=UniPrep API Docs
SWAGGER_DESCRIPTION=UniPrep API documentation
SWAGGER_VERSION=1.0

# ----- CORS -----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Xác thực (dùng từ E1) -----
# JWT_SECRET phải là chuỗi ngẫu nhiên >= 32 ký tự và KHÔNG được commit.
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-toi-thieu-32-ky-tu
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ALGORITHM=HS256
PASSWORD_RESET_TTL=30m
BCRYPT_SALT_ROUNDS=10

# ----- Redis + hàng đợi (dùng từ E9-T7) -----
# Redis chạy bằng Docker Compose hoặc bản cài Windows; để trống REDIS_PASSWORD ở dev.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RATE_LIMIT_ENABLED=true

# ----- AI service FastAPI (dùng từ E9-T1) -----
# Ở máy dev service chạy cùng máy nên dùng 127.0.0.1; trong Docker Compose đổi
# thành http://ai-service:8000.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=doi-thanh-chuoi-ngau-nhien
AI_QUEUE_NAME=ai-risk
AI_JOB_TIMEOUT_MS=300000

# ----- Học liệu tải lên (dùng từ E3-T4) -----
# Thư mục này KHÔNG được commit (đã nằm trong .gitignore).
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ----- Seed dữ liệu mẫu (E0-T6) -----
# Mật khẩu của 3 tài khoản demo (student/teacher/admin). Chỉ dùng ở dev;
# seed script từ chối chạy khi NODE_ENV=production.
SEED_DEMO_PASSWORD=UniPrep@2026
# Seed của bộ sinh số ngẫu nhiên: cùng giá trị ⇒ cùng bộ dữ liệu mô phỏng.
# Có thể ghi đè bằng tham số dòng lệnh: npm run seed -- --seed=123
SEED_RANDOM_SEED=20260926
