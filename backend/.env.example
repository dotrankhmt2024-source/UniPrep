# Application
PORT=3000
NODE_ENV=development

# Postgres Connection (local, no docker — chạy trực tiếp trên máy)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=uniprep

# Swagger
SWAGGER_TITLE=UniPrep API Docs
SWAGGER_DESCRIPTION=UniPrep API documentation
SWAGGER_VERSION=1.0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
