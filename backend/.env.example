# =============================================================================
# UniPrep backend — mẫu biến môi trường. Sao chép thành `.env` rồi chỉnh:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (bash)
# Danh sách biến và ý nghĩa: `docs/02-specs/api-specification.md` §14.1–14.2.
# Biến nào chưa dùng ở giai đoạn hiện tại vẫn được khai báo sẵn để máy mới không
# phải đi tìm khi làm tới module tương ứng.
# =============================================================================

# ----- Ứng dụng -----
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ----- PostgreSQL (chạy trực tiếp trên máy, không cần Docker) -----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=uniprep

# ----- Swagger -----
SWAGGER_TITLE=UniPrep API Docs
SWAGGER_DESCRIPTION=UniPrep API documentation
SWAGGER_VERSION=1.0

# ----- CORS -----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Xác thực (dùng từ E1) -----
# JWT_SECRET phải là chuỗi ngẫu nhiên >= 32 ký tự và KHÔNG được commit.
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-toi-thieu-32-ky-tu
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ALGORITHM=HS256
PASSWORD_RESET_TTL=30m
BCRYPT_SALT_ROUNDS=10

# ----- Redis + hàng đợi (dùng từ E9-T7) -----
# Redis chạy bằng Docker Compose hoặc bản cài Windows; để trống REDIS_PASSWORD ở dev.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RATE_LIMIT_ENABLED=true

# ----- AI service FastAPI (dùng từ E9-T1) -----
# Ở máy dev service chạy cùng máy nên dùng 127.0.0.1; trong Docker Compose đổi
# thành http://ai-service:8000.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=doi-thanh-chuoi-ngau-nhien
AI_QUEUE_NAME=ai-risk
AI_JOB_TIMEOUT_MS=300000

# ----- Học liệu & tệp bài nộp tải lên (dùng từ E3-T4; tệp bài nộp thêm ở E5) -----
# Thư mục này KHÔNG được commit (đã nằm trong .gitignore) và chứa CẢ hai loại tệp:
#   lessons/<lessonId>/…          — học liệu do giảng viên tải lên (phục vụ tĩnh tại /uploads/**)
#   submissions/<submissionId>/…  — tệp bài nộp của học viên (KHÔNG phục vụ tĩnh; tải qua
#                                   GET /api/submission-files/:id/download để kiểm tra quyền)
# Trần số tệp mỗi lượt nộp là hằng số trong code (MAX_SUBMISSION_FILES = 5).
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
# Gốc URL công khai của backend (KHÔNG kèm `/api`). Dùng để dựng `fileUrl` TUYỆT ĐỐI cho học liệu:
# FE chạy ở cổng khác nên đường dẫn tương đối không mở được trong thẻ <video>/<img>.
PUBLIC_BASE_URL=http://localhost:3000

# ----- Seed dữ liệu mẫu (E0-T6) -----
# Mật khẩu của 3 tài khoản demo (student/teacher/admin). Chỉ dùng ở dev;
# seed script từ chối chạy khi NODE_ENV=production.
SEED_DEMO_PASSWORD=UniPrep@2026
# Seed của bộ sinh số ngẫu nhiên: cùng giá trị ⇒ cùng bộ dữ liệu mô phỏng.
# Có thể ghi đè bằng tham số dòng lệnh: npm run seed -- --seed=123
SEED_RANDOM_SEED=20260926

# ----- Trợ giảng AI (DeepSeek, API tương thích OpenAI) -----
# Bỏ trống DEEPSEEK_API_KEY thì trang Trợ giảng AI báo chưa cấu hình.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# enabled: trả về reasoning_content (hiện trong trajectory); disabled: nhanh và rẻ hơn
DEEPSEEK_THINKING=enabled
# Tùy chọn khi bật thinking, ví dụ high
DEEPSEEK_REASONING_EFFORT=high

# ----- Thông báo -----
# Job nhắc hạn nộp (deadline_reminder). Luôn tắt khi NODE_ENV=test.
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_REMINDER_INTERVAL_MINUTES=30
# Nhắc các bài sắp hết hạn trong ngần này giờ tới
NOTIFICATION_REMINDER_WITHIN_HOURS=24

# ----- Catalog môn học (DB đề cương của trường, CHỈ ĐỌC) -----
# Kết nối thứ hai, tách khỏi DB của UniPrep. Mọi truy vấn chạy trong transaction READ ONLY và
# chỉ đọc course_outlines / course_outline_prerequisites. Bỏ trống HOST thì /api/catalog/* trả 503.
CATALOG_DB_HOST=
CATALOG_DB_PORT=5432
CATALOG_DB_USERNAME=
CATALOG_DB_PASSWORD=
CATALOG_DB_NAME=postgres
CATALOG_DB_SCHEMA=bk_uni
# require (mặc định, dùng cho Supabase) | disable
CATALOG_DB_SSL=require
CATALOG_DB_POOL_MAX=3
# Cache đề cương/đồ thị kỹ năng trong bộ nhớ, tính bằng giây; 0 = tắt
CATALOG_CACHE_TTL_SECONDS=300
