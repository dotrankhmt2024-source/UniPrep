	"info": {
		"title": "UniPrep API Docs",
		"description": "UniPrep API documentation",
		"version": "1.0",
		"contact": {}
	},
	"tags": [],
	"servers": [],
	"components": {
		"securitySchemes": {
			"bearer": {
				"scheme": "bearer",
				"bearerFormat": "JWT",
				"type": "http"
			}
		},
		"schemas": {
			"RegisterDto": {
				"type": "object",
				"properties": {
					"email": {
						"type": "string",
						"example": "sv2026001@hcmut.edu.vn",
						"description": "Email đăng nhập, không phân biệt hoa/thường",
						"maxLength": 255
					},
					"password": {
						"type": "string",
						"example": "Abcd@1234",
						"description": "Chính sách mật khẩu ở §5.1 (8–16 ký tự, hoa, thường, số, ký tự đặc biệt)"
					},
					"fullName": {
						"type": "string",
						"example": "Nguyễn Văn A",
						"minLength": 1,
						"maxLength": 100
					},
					"studentCode": {
						"type": "string",
						"example": "SV2026001",
						"description": "Chỉ dùng khi tạo học viên; duy nhất nếu có",
						"maxLength": 50
					}
				},
				"required": [
					"email",
					"password",
					"fullName"
				]
			},
			"ApiResponseDto": {
				"type": "object",
				"properties": {
					"error": {
						"type": "boolean",
						"example": false
					},
					"data": {
						"type": "object",
						"description": "Payload data (object, array, primitive) or null",
						"nullable": true
					},
					"message": {
						"type": "string",
						"example": "Success"
					}
				},
				"required": [
					"error",
					"message"
				]
			},
			"LoginDto": {
				"type": "object",
				"properties": {
					"email": {
						"type": "string",
						"example": "sv2026001@hcmut.edu.vn"
					},
					"password": {
						"type": "string",
						"example": "Abcd@1234",
						"minLength": 1
					}
				},
				"required": [
					"email",
					"password"
				]
			},
			"RefreshTokenDto": {
				"type": "object",
				"properties": {
					"refreshToken": {
						"type": "string",
						"example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
						"description": "Refresh token nhận được từ lần đăng nhập/refresh trước đó"
					}
				},
				"required": [
					"refreshToken"
				]
			},
			"LogoutDto": {
				"type": "object",
				"properties": {
					"refreshToken": {
						"type": "string",
						"description": "Refresh token của phiên cần kết thúc; bỏ trống để kết thúc mọi phiên"
					}
				}
			},
			"ForgotPasswordDto": {
				"type": "object",
				"properties": {
					"email": {
						"type": "string",
						"example": "sv2026001@hcmut.edu.vn"
					}
				},
				"required": [
					"email"
				]
			},
			"ResetPasswordDto": {
				"type": "object",
				"properties": {
					"token": {
						"type": "string",
						"example": "4f2a9c1d8b3e5a7f0c6d2e4b8a1f3c5d",
						"description": "Token một lần nhận từ email (dev: ghi ra log của server)"
					},
					"password": {
						"type": "string",
						"example": "Abcd@1234"
					}
				},
				"required": [
					"token",
					"password"
				]
			},
			"ChangePasswordDto": {
				"type": "object",
				"properties": {
					"currentPassword": {
						"type": "string",
						"example": "Abcd@1234"
					},
					"newPassword": {
						"type": "string",
						"example": "Xyz@9876"
					}
				},
				"required": [
					"currentPassword",
					"newPassword"
				]
			},
			"UpdateUserStatusDto": {
				"type": "object",
				"properties": {
					"status": {
						"type": "string",
						"enum": [
							"pending",
							"active",
							"suspended",
							"disabled"
						],
						"example": "suspended",
						"description": "pending: Chờ kích hoạt · active: Đang hoạt động · suspended: Tạm khoá · disabled: Đã vô hiệu hoá"
					}
				},
				"required": [
					"status"
				]
			}
		}
	}
}
