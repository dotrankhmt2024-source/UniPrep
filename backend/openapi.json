		"/api/users": {
			"get": {
				"operationId": "UserController_findAll",
				"parameters": [
					{
						"name": "page",
						"required": false,
						"in": "query",
						"schema": {
							"minimum": 1,
							"default": 1,
							"example": 1,
							"type": "number"
						}
					},
					{
						"name": "take",
						"required": false,
						"in": "query",
						"schema": {
							"minimum": 1,
							"maximum": 100,
							"default": 20,
							"example": 20,
							"type": "number"
						}
					},
					{
						"name": "order",
						"required": false,
						"in": "query",
						"description": "Thứ tự sắp xếp theo trường `sortBy`.",
						"schema": {
							"default": "desc",
							"type": "string",
							"enum": ["asc", "desc"]
						}
					},
					{
						"name": "search",
						"required": false,
						"in": "query",
						"description": "Từ khoá tìm kiếm (tuỳ endpoint quyết định tìm trên trường nào).",
						"schema": {
							"maxLength": 100,
							"type": "string"
						}
					},
					{
						"name": "role",
						"required": false,
						"in": "query",
						"description": "student: Học viên · teacher: Giảng viên · admin: Quản trị viên",
						"schema": {
							"type": "string",
							"enum": ["student", "teacher", "admin"]
						}
					},
					{
						"name": "status",
						"required": false,
						"in": "query",
						"description": "pending: Chờ kích hoạt · active: Đang hoạt động · suspended: Tạm khoá · disabled: Đã vô hiệu hoá",
						"schema": {
							"type": "string",
							"enum": ["pending", "active", "suspended", "disabled"]
						}
					},
					{
						"name": "sortBy",
						"required": false,
						"in": "query",
						"description": "Trường sắp xếp; luôn có `id` làm khoá phụ để phân trang ổn định.",
						"schema": {
							"default": "createdAt",
							"type": "string",
							"enum": ["createdAt", "fullName", "email"]
						}
					}
				],
				"responses": {
					"200": {
						"description": "",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiResponseDto"
								}
							}
						}
					}
				},
				"security": [
					{
						"bearer": []
					}
				],
				"summary": "Danh sách người dùng có lọc và phân trang (chỉ admin)",
				"tags": ["Users"]
			}
		},
